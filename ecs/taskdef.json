{
  "family": "md6-todo-dev-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::711387109786:role/md6-todo-dev-ecs-task-execution",
  "taskRoleArn": "arn:aws:iam::711387109786:role/md6-todo-dev-ecs-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "app",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "DJANGO_ALLOWED_HOSTS", "value": "*" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "POSTGRES_HOST", "value": "md6-todo-dev-db-proxy.proxy-cwdsq2qouvd7.us-east-1.rds.amazonaws.com" },
        { "name": "POSTGRES_PORT", "value": "5432" },
        { "name": "POSTGRES_DB", "value": "todoapp" },
        { "name": "REDIS_HOST", "value": "md6-todo-dev-redis.otzsqj.ng.0001.use1.cache.amazonaws.com" },
        { "name": "REDIS_PORT", "value": "6379" }
      ],
      "secrets": [
        { "name": "POSTGRES_USER", "valueFrom": "arn:aws:secretsmanager:us-east-1:711387109786:secret:md6-todo-dev-db-credentials-ub2jOF:username::" },
        { "name": "POSTGRES_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:711387109786:secret:md6-todo-dev-db-credentials-ub2jOF:password::" },
        { "name": "DJANGO_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:711387109786:secret:md6-todo-dev-django-secret-key-tm75mu:SECRET_KEY::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/md6-todo-dev",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
